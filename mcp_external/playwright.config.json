{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true
    }
  },
  "capabilities": ["core-navigation"],
  "saveSession": false,
  "sharedBrowserContext": false,
  "outputDir": "/srv/local-ai-data/playwright-mcp",
  "outputMaxSize": 10485760,
  "network": {
    "blockedOrigins": [
      "http://127.0.0.1:*",
      "http://localhost:*",
      "http://[::1]:*",
      "http://169.254.169.254:*",
      "https://127.0.0.1:*",
      "https://localhost:*",
      "https://[::1]:*",
      "https://169.254.169.254:*"
    ]
  }
}
