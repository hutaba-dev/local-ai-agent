[Unit]
Description=Local identity-preserving portrait pose correction service
After=network-online.target qwen-vllm.service
Wants=network-online.target
Requires=qwen-vllm.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/local-ai-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/local-ai-agent/liveportrait-venv/bin/python -m uvicorn pose_service.app:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target