[Unit]
Description=Local VS Code Qwen compatibility adapter
After=network-online.target qwen-vllm.service
Wants=network-online.target
Requires=qwen-vllm.service
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/local-ai-agent
Environment=PYTHONUNBUFFERED=1
Environment=VSCODE_ADAPTER_HOST=127.0.0.1
Environment=VSCODE_ADAPTER_PORT=8001
Environment=VSCODE_ADAPTER_UPSTREAM=http://127.0.0.1:8000
Environment=VSCODE_ADAPTER_ROLE_DEBUG=false
ExecStart=/root/local-ai-agent/vscode_adapter/run.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
