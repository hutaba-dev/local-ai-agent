# Copy operational overrides to /etc/local-ai-agent/vllm.env. Do not commit it.
MODEL=Qwen/Qwen3.8-27B
SERVED_MODEL_NAME=qwen3.8-27b
HOST=127.0.0.1
PORT=8000
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=8
HF_HOME=/srv/local-ai-agent/huggingface
HF_HUB_CACHE=/srv/local-ai-agent/models
VLLM_CACHE_ROOT=/srv/local-ai-agent/vllm-cache
LOG_DIR=/var/log/local-ai-agent
VLLM_USE_FLASHINFER_SAMPLER=0
TENSOR_PARALLEL_SIZE=2
DISABLE_CUSTOM_ALL_REDUCE=1
NCCL_P2P_DISABLE=1
