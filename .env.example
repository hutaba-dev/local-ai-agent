# Local API endpoint for Agent/UI clients. Keep real tokens and private settings in .env.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=qwen3.8-27b

# Optional persistent local agent memory. This path is ignored by Git.
LOCAL_MEMORY_DB=local-memory/agent.sqlite3

# Browser UI authentication. Generate a distinct random value and keep it out of Git.
WEB_SESSION_SECRET=replace-with-a-long-random-secret
WEB_USER_DB=local-memory/web-users.sqlite3

# Optional automatic web verification for current facts and deep research.
# Keep the real key only in the ignored host .env file.
BRAVE_SEARCH_API_KEY=replace-with-brave-search-api-key
NAVER_SEARCH_CLIENT_ID=replace-with-naver-client-id
NAVER_SEARCH_CLIENT_SECRET=replace-with-naver-client-secret

# Optional independent academic-evidence sources for Deep Research.
# Semantic Scholar works without a key at a low public rate; set a key for reliable capacity.
S2_API_KEY=replace-with-semantic-scholar-api-key
# Unpaywall requires a contact email and returns only legal open-access locations for DOI records.
UNPAYWALL_EMAIL=replace-with-contact-email@example.com

# Reserved for future provider adapters. They are not called until enabled.
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
GOOGLE_SEARCH_API_KEY=replace-with-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=replace-with-google-programmable-search-engine-id