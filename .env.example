# Local API endpoint for Agent/UI clients. Keep real tokens and private settings in .env.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=qwen3.8-27b

# Semantic MCP capabilities. Media remains opt-in because it executes dedicated GPU work.
MCP_ENABLED=false
MCP_MEDIA_ENABLED=false

# Optional persistent local agent memory. This path is ignored by Git.
LOCAL_MEMORY_DB=local-memory/agent.sqlite3

# Browser UI authentication. Generate a distinct random value and keep it out of Git.
WEB_SESSION_SECRET=replace-with-a-long-random-secret
WEB_USER_DB=local-memory/web-users.sqlite3

# Conditional web verification for current facts and deep research. The default
# order stops as soon as quality is sufficient, avoiding unnecessary paid calls.
SEARXNG_URL=http://127.0.0.1:8088
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=replace-with-brave-search-api-key
SEARCH_PROVIDER_ORDER=searxng,serper,brave
SEARCH_PROVIDER_TIMEOUT_SECONDS=8
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_CURRENT_TTL_SECONDS=1200
SEARCH_CACHE_GENERAL_TTL_SECONDS=21600
SEARCH_CACHE_ACADEMIC_TTL_SECONDS=259200
SEARCH_CIRCUIT_FAILURE_THRESHOLD=2
SEARCH_CIRCUIT_COOLDOWN_SECONDS=120
INITIAL_SEARCH_QUERY_BUDGET=3
NAVER_SEARCH_CLIENT_ID=replace-with-naver-client-id
NAVER_SEARCH_CLIENT_SECRET=replace-with-naver-client-secret

# Optional independent academic-evidence sources for Deep Research.
# Elsevier Scopus requires a developer API key. Some views and endpoints also require
# institutional entitlement; set the institutional token only when Elsevier issued one.
SCOPUS_API_KEY=replace-with-elsevier-api-key
SCOPUS_INST_TOKEN=replace-with-elsevier-institution-token
# Web of Science Starter and Researcher APIs use separate Clarivate application keys.
# Researcher API access is a separate paid entitlement; Starter plans may omit times-cited.
WOS_API_KEY=replace-with-clarivate-starter-api-key
WOS_RESEARCHER_API_KEY=replace-with-clarivate-researcher-api-key
# Semantic Scholar works without a key at a low public rate; set a key for reliable capacity.
S2_API_KEY=replace-with-semantic-scholar-api-key
# Unpaywall requires a contact email and returns only legal open-access locations for DOI records.
UNPAYWALL_EMAIL=replace-with-contact-email@example.com

# Reserved for future provider adapters. They are not called until enabled.
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
GOOGLE_SEARCH_API_KEY=replace-with-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=replace-with-google-programmable-search-engine-id